# Ignore bundler config.
/.bundle

# Ignore all environment files.
.env
.env.*

# Kamal secrets
.kamal/secrets

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore storage (uploaded files in development).
/storage/*
!/storage/.keep

# Ignore master key and credentials (using .env instead)
/config/master.key
/config/credentials.yml.enc
/config/credentials/*.key

# Ignore bootsnap cache.
/tmp/cache/bootsnap*

# Python / venv
.venv/

# Claude
.claude/auto-context.md

# Scripts output
scripts/__pycache__/
scripts/cover_preview/
scripts/.DS_Store
scripts/*.csv

# Scripts – local session / auth (sensitive, never commit)
scripts/*_session.json
scripts/*_signed_headers.json
scripts/completed_tags.json

# Scripts – local work files (personal, not code)
scripts/names.txt
scripts/names_missing.txt

.DS_Store
